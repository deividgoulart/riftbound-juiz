# Modelo dos "secrets" do app publicado no Streamlit Cloud.
# Não coloque valores reais neste arquivo: ele vai pro GitHub.
# No Streamlit Cloud, cole o conteúdo (com os valores preenchidos) em
# Settings > Secrets. Localmente, o app usa o .env e não precisa deste arquivo.

# Chave do Google AI Studio (a mesma do .env).
GEMINI_API_KEY = ""

# Chave do Groq (console.groq.com/keys, plano grátis): reserva usada quando os
# modelos Gemini estão sobrecarregados. Sem ela, o app só usa o Gemini.
GROQ_API_KEY = ""

# Senha que libera o uso sem limite. Com ela definida, o app entra no modo
# convidado (limite por visita e por dia) pra quem não tem a senha.
SENHA_DO_APP = ""

# Banco do deck builder no Turso (turso.tech, plano grátis): guarda a coleção e os
# decks, que sumiriam a cada reinício do app sem ele. Passo a passo no .env.example.
TURSO_DATABASE_URL = ""
TURSO_AUTH_TOKEN = ""
