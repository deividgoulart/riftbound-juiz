# Copie este arquivo para ".env" e preencha as chaves.
# O .env fica só na sua máquina: ele está no .gitignore e nunca vai para o GitHub.

# Chave do Google AI Studio (https://aistudio.google.com/apikey), usada pelo modelo de
# embeddings "gemini-2" na comparação da etapa 4. O tier grátis basta pra este projeto.
GEMINI_API_KEY=

# Chave da API do LLM (escolhido na etapa 5).
# LLM_API_KEY=
