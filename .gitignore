# --- Segredos ---
# O .env guarda chaves de API e NUNCA deve ir para o GitHub. O mesmo vale pros secrets do Streamlit.
.env
.streamlit/secrets.toml

# --- Ambiente Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Dados ---
# Os dados são baixados/gerados pelos scripts, então não precisam ir para o repositório.
# (Além disso, o conteúdo do FAQ tem licença própria: CC BY-SA 4.0.)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Índice vetorial (etapa 4), registro das conversas do app (etapa 6) e da última atualização (etapa 8).
# Os vetores SEM texto ficam em data/vetores/ e vão pro GitHub (o app publicado reaproveita).
data/index/
data/logs/
data/atualizacao.json

# Configuração local do Claude Code (servidor de pré-visualização)
.claude/

# --- Editores / sistema ---
.vscode/
.idea/
Thumbs.db
.DS_Store
