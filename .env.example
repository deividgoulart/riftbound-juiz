# Copie este arquivo para ".env" e preencha as chaves.
# O .env fica só na sua máquina: ele está no .gitignore e nunca vai para o GitHub.

# Chave do Google AI Studio (https://aistudio.google.com/apikey). Serve pros embeddings da
# busca (Gemini Embedding 2) e pro LLM que escreve as respostas. O tier grátis basta.
GEMINI_API_KEY=

# Opcional, mas recomendado: chave do Groq (https://console.groq.com/keys, plano grátis). É a reserva
# de outra empresa, usada quando os modelos Gemini estão sobrecarregados.
GROQ_API_KEY=

# Opcional: com uma senha aqui, a API roda como se estivesse publicada (modo convidado com
# limites; a senha libera o uso sem limite e a edição). Deixe comentado pra usar sem limite no seu computador.
# SENHA_DO_APP=

# Opcional (API publicada): endereço do site, pra só ele poder chamar a API pelo navegador.
# Vários endereços separados por vírgula. Sem ela, qualquer site pode (a edição continua pedindo a senha).
# SITE_URL=https://seu-site.vercel.app

# Opcional (deck builder, fase 2): banco na nuvem Turso, pra coleção e os decks sobreviverem aos
# reinícios da API publicada. Sem as duas, o deck builder usa o arquivo local data/decks.sqlite.
# Como criar (plano grátis): conta em https://turso.tech, depois, no terminal do Turso:
#   turso db create riftbound-decks
#   turso db show riftbound-decks --url      -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create riftbound-decks   -> TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Opcional (deck builder): chave grátis da API do TopDeck.gg, pros decks de torneio (decks do meta).
# Crie na sua conta em https://topdeck.gg (seção da API). Sem ela, a aba "Decks do meta" fica desligada.
# TOPDECK_API_KEY=
