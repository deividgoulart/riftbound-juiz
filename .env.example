# Copie este arquivo para ".env" e preencha as chaves.
# O .env fica só na sua máquina: ele está no .gitignore e nunca vai para o GitHub.

# Chave do Google AI Studio (https://aistudio.google.com/apikey). Serve pros embeddings da
# busca (Gemini Embedding 2) e pro LLM que escreve as respostas. O tier grátis basta.
GEMINI_API_KEY=

# Opcional, mas recomendado: chave do Groq (https://console.groq.com/keys, plano grátis). É a reserva
# de outra empresa, usada quando os modelos Gemini estão sobrecarregados.
GROQ_API_KEY=

# Opcional: com uma senha aqui, o app roda como se estivesse publicado (modo convidado com
# limites; a senha libera o uso sem limite). Deixe comentado pra usar sem limite no seu computador.
# SENHA_DO_APP=

# Opcional (deck builder, fase 2): banco na nuvem Turso, pra coleção e os decks sobreviverem aos
# reinícios do app publicado. Sem as duas, o deck builder usa o arquivo local data/decks.sqlite.
# Como criar (plano grátis): conta em https://turso.tech, depois, no terminal do Turso:
#   turso db create riftbound-decks
#   turso db show riftbound-decks --url      -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create riftbound-decks   -> TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
